# Doxyfile für libiso8583
# Doxygen parst die C++-Header und erzeugt XML, das Breathe an Sphinx weitergibt.
# Aufruf: doxygen docs/Doxyfile  (ab Repo-Root)

PROJECT_NAME           = "libiso8583"
PROJECT_NUMBER         = "0.2.0"
PROJECT_BRIEF          = "C++20 ISO 8583 Finanznachrichten-Parser und -Builder"
PROJECT_LOGO           =

# Ausgabe: nur XML (davon liest Sphinx/Breathe, nicht das HTML)
OUTPUT_DIRECTORY       = docs/_doxygen
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# Eingang: nur die öffentlichen Header
INPUT                  = include/iso8583
FILE_PATTERNS          = *.hh *.h
RECURSIVE              = YES

# Legacy- und externe Third-Party-Dateien ausschließen
EXCLUDE_PATTERNS       = */detail/extern/* \
                         *_codec_impl.hh \
                         *.LEGACY
EXCLUDE                = include/iso8583/detail/extern

# detail/_codec_impl.hh enthält NUR die Template-Definitionen der Funktionen,
# die in _codec.hh deklariert (und dokumentiert) sind. Ohne Ausschluss erzeugt
# Doxygen für jede Funktion zwei Member-Knoten (Deklaration + Definition) mit
# identischer ID im XML → Breathe: "Duplicate C++ declaration" / "Duplicate ID".
# Die übrigen detail/-Header bleiben drin: _components.hh / _interfaces.hh
# definieren die dokumentierten Klassen (ISOMessage, ISOParserPtrBase, ...).

# kAsciiToEbcdic wird per Lambda initialisiert (static const ... = [](){...}()).
# Breathe's C++-Parser kann Lambda-Initialisatoren nicht parsen
# ("Invalid C++ declaration: Expected identifier in nested name" →
#  "Parsing of expression failed" → mit -W ein Build-Fehler).
# Primärer Schutz: #ifndef DOXYGEN-Guard um die Variable in _codec.hh
# (Doxygen definiert DOXYGEN beim Preprocessing, der C++-Build ist unbeeinflusst).
# EXCLUDE_SYMBOLS hier als redundanter Sicherheitsnetz (wirkt je nach
# Doxygen-Version nicht auf Namespace-Variablen).
EXCLUDE_SYMBOLS        = iso8583::codec::kAsciiToEbcdic

# Alles extrahieren – auch ungedokumentete Mitglieder
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# Markdown-Support
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Brief/Detail-Verarbeitung
# QT_AUTOBRIEF + JAVADOC_AUTOBRIEF beide aus: verhindert einen Breathe-Crash
# an docSect2TypeSub-Knoten, die entstehen, wenn Doxygen @code-Blöcke in
# Abschnitten parst, die durch Autobrief am ersten Punkt geteilt werden.
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

# @section/@subsection-Auswertung deaktiviert, um den Breathe-Bug
# 'docSect2TypeSub has no attribute title' zu vermeiden (Breathe-Issue #830).
# Abschnittsgliederung in ///-Kommentaren sollte stattdessen in Fließtext erfolgen.
ALIASES                = "section{1}=\par \1" \
                         "subsection{1}=\par \1"

# Doxygen soll C++20 verstehen
EXTENSION_MAPPING      = hh=C++ h=C++
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
# Makronamen entsprechen den Quellen in include/iso8583/config.h – nicht ändern.
# __DOXYGEN__=1: aktiviert die #ifndef __DOXYGEN__-Guards in den Headern
# (z.B. um Lambda-initialisierte Lookup-Tabellen aus dem Breathe-Parser
#  herauszuhalten); echte C++-Builds sehen diese Definition nie.
PREDEFINED             = TNG_EXPORT= \
                         TNG_NAMESPACE=iso8583 \
                         TNG_KEY_TYPE=int16_t \
                         __DOXYGEN__=1 \
                         "ISOComponentPtrBaseSmartPtr=std::shared_ptr<ISOComponentPtrBase>" \
                         "ISOFieldParserPtrBaseSmartPtr=std::shared_ptr<ISOFieldParserPtrBase>" \
                         "ISOParserPtrBaseSmartPtr=std::shared_ptr<ISOParserPtrBase>" \
                         "ISOHeaderSmartPtr=std::shared_ptr<ISOHeader>"

# Warnungen
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = NO
WARNINGS               = YES