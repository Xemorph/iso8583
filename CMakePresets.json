{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "ISO8583_BUILD_SHARED": "ON",
        "ISO8583_ENABLE_ICONV": "ON",
        "ISO8583_INSTALL":      "OFF"
      }
    },

    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":   "Debug",
        "ISO8583_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":    "Release",
        "ISO8583_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "debug-bertlv",
      "displayName": "Debug (Ninja) - BER-TLV/int32_t-Keys",
      "inherits": "debug",
      "cacheVariables": {
        "ISO8583_BERTLV": "ON"
      }
    },

    {
      "name": "debug-asan",
      "displayName": "Debug + AddressSanitizer (MSVC /fsanitize=address, statisch)",
      "description": "Sanitizer-Preset: MSVC-ASan mit statischer CRT (/MTd), statischem iso8583 und x64-windows-static-Triplet. ASan-Runzeit wird statisch verlinkt -> kein DLL-Suche-Problem unter ctest.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":                "Debug",
        "ISO8583_BUILD_TESTS":             "ON",
        "ISO8583_BUILD_SHARED":            "OFF",
        "VCPKG_TARGET_TRIPLET":            "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY":      "MultiThreadedDebug",
        "CMAKE_C_FLAGS":                   "/fsanitize=address /Zi",
        "CMAKE_CXX_FLAGS":                 "/fsanitize=address /Zi",
        "CMAKE_EXE_LINKER_FLAGS":          "/fsanitize=address",
        "CMAKE_STATIC_LIBRARY_LINK_FLAGS": "/fsanitize=address"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "ThreadSanitizer (nur Linux-CI mit clang)",
      "description": "TSan-Preset: nur unter Linux mit clang verwendbar (Compiler z.B. via CMAKE_C(XX)_COMPILER=clang in der CI setzen). Auf Windows/MSVC nicht konfigurierbar.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":                "Debug",
        "ISO8583_BUILD_TESTS":             "ON",
        "ISO8583_BUILD_SHARED":            "OFF",
        "CMAKE_CXX_FLAGS":                 "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS":          "-fsanitize=thread",
        "CMAKE_SHARED_LIBRARY_LINK_FLAGS": "-fsanitize=thread"
      }
    },

    {
      "name": "msvc-debug",
      "displayName": "Debug (MSVC)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":    "Debug",
        "ISO8583_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "Release (MSVC)",
      "inherits": "msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":    "Release",
        "ISO8583_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "msvc-debug-static",
      "displayName": "Debug (MSVC) - fmt/... statisch in iso8583.dll",
      "inherits": "msvc-debug",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "msvc-release-static",
      "displayName": "Release (MSVC) - fmt/... statisch in iso8583.dll",
      "inherits": "msvc-release",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "debug-asan",
      "configurePreset": "debug-asan"
    },
    {
      "name": "debug-bertlv",
      "configurePreset": "debug-bertlv"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug-static",
      "configurePreset": "msvc-debug-static",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release-static",
      "configurePreset": "msvc-release-static",
      "configuration": "Release"
    }
  ],

  "testPresets": [
    {
      "name": "debug",
      "displayName": "Alle Tests (Debug)",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "filter": {
        "exclude": { "label": "slow" }
      }
    },
    {
      "name": "debug-asan",
      "displayName": "Alle Tests (Debug + ASan)",
      "configurePreset": "debug-asan",
      "output": { "outputOnFailure": true, "verbosity": "default" }
    },
    {
      "name": "debug-bertlv",
      "displayName": "Alle Tests (Debug, int32_t-Keys)",
      "configurePreset": "debug-bertlv",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "filter": {
        "exclude": { "label": "slow" }
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "Alle Tests (MSVC Debug)",
      "configurePreset": "msvc-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-debug-static",
      "displayName": "Alle Tests (MSVC Debug, statische vcpkg-Libs)",
      "configurePreset": "msvc-debug-static",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
